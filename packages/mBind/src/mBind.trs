local mCleanup = import("/mLibraries/mCleanup")
local marker = {}
local scope_marker = {}
local writers = {}
local writer_claims = 0
local releases = []
local factories = {}
local properties = {}
local events = {}

# Native objects do not support string member indexing. These adapters are explicit.
factories.ScreenUI = expr(): new ScreenUI()
factories.UIPanel = expr(): new UIPanel()
factories.UITextPanel = expr(): new UITextPanel()
factories.UIButton = expr(): new UIButton()
factories.UITextInput = expr(): new UITextInput()
