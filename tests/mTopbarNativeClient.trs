suite.Test("standalone disable and enable settle actual native visual properties", func():
    WithBar(func(bar):
        local icon = bar.Add({ Name = "fade", Label = "F" })
        local button = FixtureButton("fade")
        local visual = FixtureVisual("fade")
        icon.SetEnabled(false)
