        local previous = MovingTween(visual)
        suite.Expect(visual.Transparency > 0, "the old fade actually started")
        icon.SetEnabled(true)
        AwaitVisual(visual, 1, 0)
        suite.Expect(not previous.IsInDataModel, "superseded native tween is released")
        WaitSpan(0.22)
        CheckVisual(visual, 1, 0, "old completion cannot restore disabled state")
    )
)

