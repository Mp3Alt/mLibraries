# Optional local Creator fixture. Real native transport; no cloud or accounts.

if game.ServerId != "": throw "mNet native fixture is for Creator playtests only."
local mNet = import("/mLibraries/mNet")
local mPacket = import("/mLibraries/mPacket")
local mCleanup = import("/mLibraries/mCleanup")
local suite = import("/mLibraries/mTestKit").New("mNetNative")
local folder = world.WaitForChild("mNetNative", 20)
if folder == nil: throw "mNet native server fixture was not found."
local remote = folder.WaitForChild("Messages", 10)
if remote == nil: throw "mNet native remote was not found."
local client = mNet.NewClient({ Remote = remote, Timeout = 3 })
local lifetime = mCleanup.New()
lifetime.AddConnection(game.TimeSystem.FrameStepped.Connect(func(delta): client.Step()))
local Await = func(call):
    for turn in range(300):
        local result = call.GetOutcome()
        if result.Status != "Pending": return result
        wait(0)
    throw "mNet request did not settle within the native fixture bound."

local packet = mPacket.New({ Id = 71, Fields = [{ Name = "Amount", Type = "integer", Min = -100, Max = 100 }] })
try:
    suite.Test("native transport roundtrips zero false and nil", func():
        for value in [0, false, nil]:
            local result = Await(client.Request("echo", value))
            suite.Expect(result.Ok, "native response succeeded")
            suite.Equal(result.Value, value, "native falsy value preserved")
    )
    suite.Test("native actor cannot be replaced by payload identity", func():
        local result = Await(client.Request("actor", { UserId = 999, Owner = true }))
        suite.Expect(result.Ok, "actor request succeeded")
        suite.Equal(result.Value, game.Players.LocalPlayer.UserId, "engine sender identity")
    )
    suite.Test("mPacket decoder composes without a transport dependency", func():
        local encoded = packet.Encode([{ Amount = -7 }])
        local result = Await(client.Request("packet", encoded.Value))
        suite.Expect(result.Ok, "schema validated at receiver")
        suite.Equal(result.Value, -7, "canonical packet value")
    )
    suite.Test("denied native route returns only the fixed failure", func():
        local result = Await(client.Request("denied", nil))
        suite.Equal(result.Code, "Denied", "authorization denied")
        suite.Equal(result.Value, nil, "no handler data")
    )
    suite.Test("native timeout ignores the later server reply", func():
        local call = client.Request("slow", 7, nil, 0.02)
        suite.Equal(Await(call).Status, "TimedOut", "waiting timed out")
        wait(0.3)
        suite.Equal(call.GetOutcome().Status, "TimedOut", "late reply did not revive request")
    )
    suite.Test("native cancellation does not revive on a later reply", func():
        local call = client.Request("slow", 7)
        suite.Expect(call.Cancel(), "local cancellation accepted")
        wait(0.3)
        suite.Equal(call.GetOutcome().Status, "Cancelled", "cancelled request remains terminal")
    )
    suite.Test("native server push reaches a subscribed client with falsy data", func():
        local seen = { NilValue = false, FalseValue = false, ZeroValue = false, Count = 0 }
        local subscription = client.On("notice", func(value):
            seen.Count += 1
            if value == nil: seen.NilValue = true
            elif value == false: seen.FalseValue = true
            elif value == 0: seen.ZeroValue = true
        )
        try:
            suite.Expect(Await(client.Request("pushready", nil)).Ok, "ready handshake succeeded")
            for turn in range(300):
                if seen.Count >= 3: break
                wait(0)
            suite.Equal(seen.Count, 3, "three actual pushes received")
            suite.Expect(seen.NilValue and seen.FalseValue and seen.ZeroValue, "native push preserves falsy values")
        finally:
            subscription.Disconnect()
    )
    suite.Test("native endpoint teardown settles its pending request", func():
        local call = client.Request("slow", 7)
        client.Destroy()
        suite.Equal(call.GetOutcome().Code, "Destroyed", "pending request settled by teardown")
        suite.Expect(client.IsDestroyed(), "endpoint closed")
        # Consume the fixture's outstanding transport reply after endpoint disposal.
        local tail = remote.Connect(func(wire): pass)
        try:
            wait(0.3)
        finally:
            tail.Disconnect()
    )
finally:
    client.Destroy()
    lifetime.Destroy()

local report = suite.Report()
print(report.Name + ": " + report.Passed + " passed, " + report.Failed + " failed")
for failure in report.Failures: print(report.Name + ": " + failure)
