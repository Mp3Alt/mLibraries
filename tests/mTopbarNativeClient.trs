)

suite.Test("dock ownership and usable-viewport geometry retain native pitch and padding", func():
    WithBar(func(bar):
        wait(0)
        bar.SetInsets(0, 0, 4096)
        local first = bar.Add({ Name = "first", Label = "1" })
        local second = bar.Add({ Name = "second", Label = "2" })
        local dock = bar.Dock(first, second)
        local screen = game.UICanvas.FindFirstChild("mTopbarTests")
        local frame = screen.FindFirstChild("Dock")
        local a = FixtureButton("first")
        local b = FixtureButton("second")
        suite.Expect(not dock.IsDestroyed() and bar.GetCount() == 2, "both members remain owned")
        suite.Expect(frame != nil and a.Parent == screen and b.Parent == screen, "independent native roots exist")
        if not DockRoom(screen): return
        suite.Equal(frame.Size.X, 96, "two native cells plus outer padding")
        suite.Equal(frame.Size.Y, 48, "native dock height")
        suite.Equal(a.Size.X, 44, "first hit cell width")
        suite.Equal(b.Size.X, 44, "second hit cell width")
        suite.Expect(Near(LeftEdge(a) - LeftEdge(frame), 4), "left outer padding")
        suite.Expect(Near(LeftEdge(b) - LeftEdge(a), 44), "native cell pitch")
        suite.Expect(Near(LeftEdge(frame) + frame.Size.X - LeftEdge(b) - b.Size.X, 4), "right outer padding")
        suite.Expect(Near(LeftEdge(a) + a.Size.X / 2 - LeftEdge(frame), 26), "first native center")
        suite.Expect(Near(LeftEdge(b) + b.Size.X / 2 - LeftEdge(frame), 70), "second native center")
        CheckVisual(frame, 1, 0, "idle shared frame")
    )
)

suite.Test("one-member dock lifetime and usable-viewport geometry retain the native width", func():
