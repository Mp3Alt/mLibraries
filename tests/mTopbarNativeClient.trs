        suite.Expect(Near(tween.Params.Time, 0.2), "native transition duration")
        suite.Equal(tween.Params.Func, EasingFunc.Back, "standalone native easing")
        suite.Equal(tween.Params.Trans, EasingTrans.Out, "standalone native transition")
        AwaitVisual(visual, 1, 0.5)
        suite.Equal(button.Size.X, 48, "visual motion leaves hit width fixed")
        suite.Equal(button.Size.Y, 48, "visual motion leaves hit height fixed")
        icon.SetEnabled(true)
        AwaitVisual(visual, 1, 0)
        suite.Expect(icon.GetState().Enabled, "enabled metadata agrees with settled native state")
    )
)

suite.Test("an enabled replacement wins over an in-flight disabled fade", func():
    WithBar(func(bar):
        local icon = bar.Add({ Name = "replace", Label = "R" })
