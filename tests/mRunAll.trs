local mSignalTests = import("/mLibraries/tests/mSignalSpec")
local mCleanupTests = import("/mLibraries/tests/mCleanupSpec")
local mAsyncTests = import("/mLibraries/tests/mAsyncSpec")

local Run = func():
    local suites = []
    suites.push(mSignalTests.Run())
    suites.push(mCleanupTests.Run())
    suites.push(mAsyncTests.Run())
    local passed = 0
    local failed = 0
    for suite in suites:
        passed += suite.Passed
        failed += suite.Failed
    return { Passed = passed, Failed = failed, Suites = suites }

return { Run = Run }
