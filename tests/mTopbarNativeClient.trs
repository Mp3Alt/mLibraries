    )
)

suite.Test("replacing a menu preserves another menu owner and reentrant selection", func():
    WithBar(func(bar):
        bar.SetVisible(true)
        local first = bar.Add({ Name = "first", Label = "A" })
        local second = bar.Add({ Name = "second", Label = "B" })
        local items = [{ Text = "Entry", Run = func(icon): pass }]
        first.SetMenu(items)
        second.SetMenu(items)
        second.SetSelected(true)
        local screen = game.UICanvas.FindFirstChild("mTopbarTests")
        local popup = screen.FindFirstChild("Menu")
        local row = popup.FindFirstChild("Item0")
        suite.Expect(row != nil, "selected owner's menu is constructed even in a small viewport")
        first.SetMenu(items)
        suite.Expect(second.IsSelected(), "unrelated owner remains selected")
        suite.Equal(popup.FindFirstChild("Item0"), row, "unrelated menu retains its native row")
        first.SetSelected(true)
        first.Deselected.Connect(func(icon): second.SetSelected(true))
        first.SetMenu(items)
        suite.Expect(second.IsSelected(), "reentrant menu selection remains selected")
        suite.Expect(popup.FindFirstChild("Item0") != nil, "reentrant owner's menu remains constructed")
    )
)

suite.Test("parallel icon dock and bar destruction closes each lifetime once", func():
    for round in range(16):
        WithBar(func(bar):
            local icons = []
            local docks = []
            for index in range(16): icons.push(bar.Add({ Name = "close" + index, Label = "C" }))
            for index in range(8): docks.push(bar.Dock(icons[index * 2], icons[index * 2 + 1]))
            local done = []
            local failures = []
            for index in range(6): done.push(false)
            local Worker = func(slot):
                return func():
                    try:
                        if slot < 2: bar.Destroy()
                        elif slot < 4:
                            for dock in docks: dock.Destroy()
                        else:
                            for icon in icons: icon.Destroy()
                        bar.Destroy()
                    catch failure: failures.push(failure)
                    finally: done[slot] = true
            for index in range(6): spawn(Worker(index))
            suite.Expect(WaitAll(done), "all disposal workers completed")
            suite.Equal(failures.length, 0, "parallel disposal produced no errors")
            suite.Expect(bar.IsDestroyed(), "bar closes")
            suite.Equal(bar.GetCount(), 0, "bar has no remaining icon registrations")
            for icon in icons: suite.Expect(icon.IsDestroyed(), "each icon closes")
            for dock in docks: suite.Expect(dock.IsDestroyed(), "each dock closes")
        )
)

local report = suite.Report()
print(report.Name + ": " + report.Passed + " passed, " + report.Failed + " failed")
for failure in report.Failures:
    print(report.Name + ": " + failure)
